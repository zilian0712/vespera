{
  "name": "zhima-watch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build",
    "check:worker": "tsc -p tsconfig.worker.json",
    "preview": "vite preview --host 0.0.0.0",
    "dev:worker": "wrangler dev --ip 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "hls.js": "^1.6.0",
    "lucide-react": "^0.468.0",
    "peerjs": "^1.5.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "wrangler": "^4.0.0",
    "ws": "^8.22.1"
  }
}
